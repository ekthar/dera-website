# Docker environment variables for the Dera website
# Copy/adjust these values for your deployment. All values are optional.

# Public production origin (used for canonical URLs, Open Graph, sitemap, robots.txt)
# Example: https://www.your-domain.com  (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Contact form email delivery (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Public contact channels
NEXT_PUBLIC_CONTACT_EMAIL=

# Social profiles (footer links)
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=