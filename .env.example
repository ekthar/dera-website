# Copy to .env.local for development, and set the same variables on your host.
# Every value is optional. Empty values keep the related feature hidden or off.

# Public production origin, used for canonical URLs, Open Graph, sitemap and robots.txt.
# Example: https://www.example.com  (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Contact form email delivery (Resend, https://resend.com)
# All three are required. Until they are set, the form validates input but
# tells visitors clearly that online submission is not connected, and the
# /api/contact route answers 503.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=
# Sender on a domain you have verified in Resend, e.g. "Dera Website <website@your-domain>".
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Public contact channels. Shown only when set. Use verified business details.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=

# Social profiles. Shown in the footer only when set.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
